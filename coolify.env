# ============================================================
# mailcow on Coolify — environment file
# PASTE THIS WHOLE FILE into Coolify > your app >
# Environment Variables > Developer view (bulk editor).
# Do NOT rely on this file being read from the repo.
#
# >>> YOU MUST EDIT THE 4 VALUES MARKED "CHANGE" <<<
# ============================================================

# CHANGE 1: your mail server FQDN (must have an A record to this server)
MAILCOW_HOSTNAME=mail.example.com

# CHANGE 2: your timezone (TZ identifier, e.g. Africa/Casablanca, Europe/Paris)
TZ=Etc/UTC

# CHANGE 3: MUST equal the Coolify application UUID (shown in the app URL /
# the folder name under /data/coolify/applications/). Ofelia cron jobs,
# watchdog and the UI restart buttons break if this is wrong.
COMPOSE_PROJECT_NAME=changeme

# CHANGE 4: certificates via DNS-01 (no port 80 needed - Coolify keeps 80/443).
# Set your provider + its API credentials. Providers = acme.sh dns_* plugins.
# Docs: https://docs.mailcow.email/post_installation/firststeps-ssl-dns/
ACME_DNS_CHALLENGE=y
ACME_DNS_PROVIDER=dns_cf
ACME_ACCOUNT_EMAIL=me@example.com
# Example for Cloudflare (uncomment + fill):
#CF_Token=your_cloudflare_api_token
# If your DNS has no API: set ACME_DNS_CHALLENGE=n and read README "Certificates".

# ------------------------------------------------------------
# Generated secrets (fresh, unique to this file) - keep private
# ------------------------------------------------------------
DBNAME=mailcow
DBUSER=mailcow
DBPASS=l95bflNSdzU38VHJzVDIO6mUQQrc
DBROOT=7AvgNSDnbAK5GclzCQWHiX36vFtd
REDISPASS=VqAIsFgApLhEXqGzwxZGG5L2TqD4
SOGO_URL_ENCRYPTION_KEY=XXjyFBQs8sFXGRpx

# ------------------------------------------------------------
# Web bindings - Coolify's proxy owns 80/443, mailcow gets 8080/8443
# ------------------------------------------------------------
HTTP_PORT=8080
HTTP_BIND=
HTTPS_PORT=8443
HTTPS_BIND=
HTTP_REDIRECT=n

# ------------------------------------------------------------
# Mail ports (published directly on the host - open them in the firewall)
# ------------------------------------------------------------
SMTP_PORT=25
SMTPS_PORT=465
SUBMISSION_PORT=587
IMAP_PORT=143
IMAPS_PORT=993
POP_PORT=110
POPS_PORT=995
SIEVE_PORT=4190
DOVEADM_PORT=127.0.0.1:19991
SQL_PORT=127.0.0.1:13306
REDIS_PORT=127.0.0.1:7654

# ------------------------------------------------------------
# ACME details
# ------------------------------------------------------------
SKIP_LETS_ENCRYPT=n
ADDITIONAL_SAN=
AUTODISCOVER_SAN=y
ADDITIONAL_SERVER_NAMES=
ENABLE_SSL_SNI=n
SKIP_IP_CHECK=n
# Port 80 is not reachable from outside (Coolify owns it), skip the HTTP self-check
SKIP_HTTP_VERIFICATION=y

# ------------------------------------------------------------
# Features / sizing
# ------------------------------------------------------------
MAILCOW_PASS_SCHEME=BLF-CRYPT
# ClamAV needs ~1.5-2 GB RAM. On a small VPS set SKIP_CLAMD=y
SKIP_CLAMD=n
SKIP_OLEFY=n
SKIP_SOGO=n
# Fulltext search. On low-memory systems set SKIP_FTS=y
SKIP_FTS=n
FTS_HEAP=128
FTS_PROCS=1
SKIP_UNBOUND_HEALTHCHECK=n
ALLOW_ADMIN_EMAIL_LOGIN=n
ACL_ANYONE=disallow
MAILDIR_GC_TIME=7200
MAILDIR_SUB=Maildir
SOGO_EXPIRE_SESSION=480
LOG_LINES=9999
DOCKER_COMPOSE_VERSION=native

# ------------------------------------------------------------
# Watchdog
# ------------------------------------------------------------
USE_WATCHDOG=y
WATCHDOG_NOTIFY_BAN=n
WATCHDOG_NOTIFY_START=y
WATCHDOG_EXTERNAL_CHECKS=n
WATCHDOG_VERBOSE=n
#WATCHDOG_NOTIFY_EMAIL=you@example.com

# ------------------------------------------------------------
# Network
# ------------------------------------------------------------
IPV4_NETWORK=172.22.1
IPV6_NETWORK=fd4d:6169:6c63:6f77::/64
# Set to false if your host has NO working IPv6 (misconfig can cause an open relay)
ENABLE_IPV6=true
DISABLE_NETFILTER_ISOLATION_RULE=n
#SNAT_TO_SOURCE=
#SNAT6_TO_SOURCE=

# ------------------------------------------------------------
# Misc / usually leave alone
# ------------------------------------------------------------
DOVECOT_MASTER_USER=
DOVECOT_MASTER_PASS=
WEBAUTHN_ONLY_TRUSTED_VENDORS=n
SPAMHAUS_DQS_KEY=
#API_KEY=
#API_KEY_READ_ONLY=
#API_ALLOW_FROM=172.22.1.1,127.0.0.1

# Multi-node role (leave y on a single server)
MASTER=y
